@startuml ClientApp_Extended
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 8
top to bottom direction
skinparam nodesep 100
skinparam ranksep 150

title Client Application (extins)

' ============================================================
' Existing Data Access Layer (DAL) – kept unchanged
' ============================================================
package "Data Access Layer (DAL)" {

  class DatabaseFacade {
    -repository : IRepository
    -dispatcher : IEventDispatcher
    -pending : Map<UUID, Future<QueryResult>>
    +DatabaseFacade(repository : IRepository, dispatcher : IEventDispatcher)
    +submit(request : QueryRequest, priority : Priority) : Future<QueryResult>
  }

  DatabaseFacade ..|> DatabaseEventListener

  interface IRepository {
    +submit(request : QueryRequest) : void
  }

  class SQLiteRepository {
    -executor : IQueryExecutor
    -dispatcher : IEventDispatcher
    +SQLiteRepository(executor : IQueryExecutor, dispatcher : IEventDispatcher)
    +submit(request : QueryRequest) : void
  }
  IRepository <|.. SQLiteRepository

  interface IQueryExecutor {
    +enqueue(request : QueryRequest) : void
    +process() : void
  }

  class DatabaseExecutor {
    -queue : IRequestQueue
    -dispatcher : IEventDispatcher
    +DatabaseExecutor(queue : IRequestQueue, dispatcher : IEventDispatcher)
    +enqueue(request : QueryRequest) : void
    +process() : void
  }
  IQueryExecutor <|.. DatabaseExecutor

  interface IRequestQueue {
    +push(request : QueryRequest) : void
    +pop() : QueryRequest
    +isEmpty() : Boolean
  }

  class RequestQueue {
    -pending : PriorityQueue<QueryRequest>
    +push(request : QueryRequest) : void
    +pop() : QueryRequest
    +isEmpty() : Boolean
  }
  IRequestQueue <|.. RequestQueue

  enum Priority {
    LOW
    NORMAL
    HIGH
    CRITICAL
  }

  abstract class QueryRequest {
    -id : UUID
    -statement : String
    -parameters : Map<String, Object>
    -priority : Priority
    -createdAt : DateTime
    +QueryRequest(statement : String, parameters : Map)
    +getPriority() : Priority
    +setPriority(priority : Priority) : void
  }

  class WindowQueryRequest {
    -windowId : Int
    +WindowQueryRequest(windowId : Int)
  }
  QueryRequest <|-- WindowQueryRequest
  QueryRequest --> Priority

  class QueryResult {
    -rows : List<Map<String, Object>>
    -affectedRows : int
    -success : Boolean
  }

  abstract class DatabaseEvent {
    -occurredAt : DateTime
  }

  class QueryCompletedEvent {
    -requestId : UUID
    -result : QueryResult
  }

  class QueryFailedEvent {
    -requestId : UUID
    -message : String
  }
  DatabaseEvent <|-- QueryCompletedEvent
  DatabaseEvent <|-- QueryFailedEvent

  interface IEventDispatcher {
    +publish(event : DatabaseEvent) : void
    +subscribe(listener : DatabaseEventListener) : void
    +unsubscribe(listener : DatabaseEventListener) : void
  }

  interface DatabaseEventListener {
    +onEvent(event : DatabaseEvent) : void
  }

  class EventBus {
    -listeners : List<DatabaseEventListener>
    +publish(event : DatabaseEvent) : void
    +subscribe(listener : DatabaseEventListener) : void
    +unsubscribe(listener : DatabaseEventListener) : void
  }
  IEventDispatcher <|.. EventBus
  EventBus ..> DatabaseEventListener

  DatabaseFacade --> IRepository
  DatabaseFacade --> IEventDispatcher
  DatabaseFacade ..> QueryRequest
  DatabaseFacade ..> Priority
  DatabaseFacade ..> QueryResult

  SQLiteRepository --> IQueryExecutor
  SQLiteRepository --> IEventDispatcher
  SQLiteRepository ..> QueryRequest

  DatabaseExecutor --> IRequestQueue
  DatabaseExecutor --> IEventDispatcher
  DatabaseExecutor ..> QueryRequest

  RequestQueue o-- QueryRequest

  QueryCompletedEvent --> QueryResult
  QueryCompletedEvent --> QueryRequest
  QueryFailedEvent --> QueryRequest
  IEventDispatcher ..> DatabaseEvent
}

' ============================================================
' NEW: CommonUtils for client-side domain objects
' ============================================================
package "CommonUtils" {

  class Nod {
    -id : Int
    -fanioane : Set<String>
    -latitudine : Double
    -longitudine : Double
    +Nod(id : Int)
    +getFanion(cheie : String) : Boolean
    +setFanion(cheie : String, valoare : Boolean) : void
  }

  class Muchie {
    -nodSursa : Nod
    -nodDestinatie : Nod
    -distanta : Double
    -densitate : Double
    -vitezaMedie : Double
    -factorCongestie : Double
    -pondere : Double
    +Muchie(nodSursa : Nod, nodDestinatie : Nod, distanta : Double)
    +calculeazaPondere() : Double
  }

  class Graf {
    -noduri : List<Nod>
    -muchii : List<Muchie>
    +Graf()
    +adaugaNod(nod : Nod) : void
    +adaugaMuchie(muchie : Muchie) : void
    +getVecini(nod : Nod) : List<Nod>
    +getSubgraf(noduriInteres : List<Nod>) : Graf
  }

  class Scenariu {
    -id : UUID
    -nume : String
    -graf : Graf
    -intervalOrar : String
    -conditiiMediu : Map<String, Object>
    -dataCreare : DateTime
    +Scenariu(nume : String, graf : Graf)
    +getGraf() : Graf
  }

  Graf "1" o-- "*" Nod : contine
  Graf "1" o-- "*" Muchie : contine
  Muchie --> "2" Nod : leaga
  Scenariu --> Graf
}

package "GUI Layer (GUI)" {

  class GUIFacade {
    -database : DatabaseFacade
    -windowManager : WindowManager
    -commDispatcher : CommandDispatcher
    -localSimulator : LocalSimulator
    -visualizer : TrafficVisualization
    -scenarioControl : ScenarioControl
    -configComparator : ConfigComparator
    +GUIFacade(database : DatabaseFacade, windowManager : WindowManager, ... )
    +makeRequest(request : WindowQueryRequest, priority : Priority) : void
    +sendCommand(command : Command) : void
    +startLocalSimulation() : void
  }

  class WindowManager {
    -windowCache : List<Window>
    -currentWindow : Window
    +getWindow() : Boolean
    +cacheWindow(window : Window) : void
    +updateWindow(window : Window) : void
    +showError(message : String) : void
  }

  class WindowLoader {
    +loadWindow(window : Window) : void
  }

  class Window {
    -windowId : Int
    -panelList : List<Panel>
  }

  abstract class UIComponent {
    -id : String
    -visible : Boolean
    +render() : void
  }

  class Button {
    -label : String
    +onClick() : void
  }

  class TextView {
    -text : String
    +setText(text : String) : void
  }

  class Panel {
    -children : List<UIComponent>
    +addChild(component : UIComponent) : void
    +removeChild(component : UIComponent) : void
  }

  UIComponent <|-- Button
  UIComponent <|-- TextView
  UIComponent <|-- Panel
  Panel o-- UIComponent
  Window o-- Panel

  GUIFacade --> WindowManager
  WindowManager --> WindowLoader
  WindowManager o-- Window

  class LocalSimulator {
    -graf : Graf
    -scenariuCurent : Scenariu
    +LocalSimulator(graf : Graf)
    +simplifiedStep() : void
    +interpolate(serverUpdate : SimulationSnapshot) : void
  }

  class TrafficVisualization {
    -graf : Graf
    +renderNetwork() : void
    +renderVehicles(agents : List<AgentDisplay>) : void
    +renderHeatmap() : void
  }

  class ScenarioControl {
    -listaScenarii : List<Scenariu>
    +selecteazaScenariu(id : UUID) : Scenariu
    +configureazaParametri(parametri : Map) : void
  }

  class ConfigComparator {
    -modele : List<SimulationResult>
    +compara(m1 : SimulationResult, m2 : SimulationResult) : ComparisonReport
    +afiseazaComparatie() : void
  }

  LocalSimulator --> Graf
  LocalSimulator --> Scenariu
  TrafficVisualization --> Graf
  ScenarioControl --> Scenariu
  ConfigComparator --> SimulationResult

  GUIFacade --> LocalSimulator
  GUIFacade --> TrafficVisualization
  GUIFacade --> ScenarioControl
  GUIFacade --> ConfigComparator
}


package "Communication (COM)" {

  interface ICommunicationChannel {
    +parseRequest(input : String) : Command
    +sendCommand(command : Command) : void
  }

  class CliChannel {
    +parseRequest(input : String) : Command
    +sendCommand(command : Command) : void
  }

  class ApiChannel {
    +parseRequest(input : String) : Command
    +establishConnection() : void
    +respond(status : ExecutionStatus) : void
    +sendCommand(command : Command) : void
  }

  enum ExecutionStatus {
    SUCCESS
    STOPPED
    INTERRUPTED
    FAILED
    WAITING_FOR_INPUT
  }

  abstract class Command {
    -data : String
  }

  class PreloadCommand
  class LoadAndRunCommand
  class RunCommand
  class StoreCommand
  class ResetCommand

  class CommandDispatcher {
    -channel : ICommunicationChannel
    -localDB : DatabaseFacade
    +CommandDispatcher(channel : ICommunicationChannel, localDB : DatabaseFacade)
    +dispatch(command : Command) : void
    +awaitSubmoduleStatus(status : SubmoduleStatus) : void
  }

  enum SubmoduleStatus {
    SUBMODULE_FINISHED
    SUBMODULE_FAILED
    SUBMODULE_INTERRUPTED
    SUBMODULE_WAITING_FOR_RESOURCES
  }

  ICommunicationChannel <|.. CliChannel
  ICommunicationChannel <|.. ApiChannel

  Command <|-- PreloadCommand
  Command <|-- LoadAndRunCommand
  Command <|-- RunCommand
  Command <|-- StoreCommand
  Command <|-- ResetCommand

  ICommunicationChannel ..> Command
  ApiChannel ..> ExecutionStatus
  CommandDispatcher ..> SubmoduleStatus

  CliChannel --> CommandDispatcher
  ApiChannel --> CommandDispatcher

  CommandDispatcher --> DatabaseFacade
}

GUIFacade --> CommandDispatcher
GUIFacade --> DatabaseFacade
GUIFacade ..> QueryResult

LocalSimulator --> DatabaseFacade

CommandDispatcher ..> WindowQueryRequest

ScenarioControl --> DatabaseFacade

ConfigComparator --> DatabaseFacade

@enduml